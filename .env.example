# Copy to .env — never commit the real file.

# Explorer API key used by `forge script --verify`
ETHERSCAN_API_KEY=

# RPC endpoints used by the deploy scripts and the Base fork test suite (`make fork-test`)
POLYGON_MAINNET_RPC_URL=
BASE_MAINNET_RPC_URL=

# Optional: pin the Base fork test suite to a block for determinism / RPC caching
# BASE_FORK_BLOCK_NUMBER=
