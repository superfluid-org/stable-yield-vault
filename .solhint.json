{
  "extends": "solhint:recommended",
  "plugins": [],
  "rules": {
    "avoid-suicide": "error",
    "avoid-sha3": "warn",
    "compiler-version": ["error", "^0.8.34"],
    "func-visibility": ["warn", { "ignoreConstructors": true }],
    "import-path-check": "off",
    "use-natspec": "off",
    "no-console": ["off", { "excludedFiles": ["script/**"] }],
    "func-name-mixedcase": ["off", { "excludedFiles": ["test/**"] }]
  }
}
